{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightGuard",
  "version": "0.16.0",
  "identifier": "com.lightguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5178",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LightGuard · 轻守卫",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#070b12",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' http://127.0.0.1:5178; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5178 ws://127.0.0.1:5178; media-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMUFFOTc1RjVFMTY3RDAKUldUUVorSDFkZWthcjIyRnlvSHBRQjF0Y3BEeHBlQW5DOUZodW4zcG9lWThVQno2OHpKMjFJMisK",
      "endpoints": [
        "https://raw.githubusercontent.com/BeafJerky/LightGuard/main/update/latest.json",
        "https://gh-proxy.com/https://raw.githubusercontent.com/BeafJerky/LightGuard/main/update/latest.cn.json",
        "https://ghproxy.net/https://raw.githubusercontent.com/BeafJerky/LightGuard/main/update/latest.cn.json",
        "https://cdn.jsdelivr.net/gh/BeafJerky/LightGuard@main/update/latest.cn.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "轻量 SSH 服务器守卫",
    "longDescription": "LightGuard 是本地优先的 SSH 服务器守卫：只读采集系统信息，提供服务器桌面、终端、连接审计与配置备份。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
